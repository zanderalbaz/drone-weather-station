static uint32_t s_userFcSubscriptionDataCnt = 0;
static bool logging_active = false; // already declared in your sample
static int32_t s_logging_widget_state = 0; // to hold the widget's state
static bool save_csv = false;
static bool waiting_for_csv_name = true;
static FILE *g_csvFile = NULL;
char fileName[256] = {0};
static bool exit_script_and_shutdown = false;

void startLogging(void)
{
    logging_active = true;
    USER_LOG_INFO("Logging started.");
}

void stopLogging(void)
{
    logging_active = false;
    USER_LOG_INFO("Logging stopped.");
}

void exitScriptSaveCsv(void)
{
    save_csv = true;
    USER_LOG_INFO("Saving Script, exiting script.");
}

// New callback function to process text input (assumes UTF-8 encoded null-terminated string)
#include <errno.h>
#include <string.h>
#include <stdlib.h>
#include <stdint.h>

// Callback for text input; must return uint32_t

uint32_t OnTextInputReceived(const uint8_t *data, uint16_t dataSize)
{

    // Copy user input into fileName buffer.
    size_t copySize = (dataSize < sizeof(fileName) - 1) ? dataSize : sizeof(fileName) - 1;
    memcpy(fileName, data, copySize);
    fileName[copySize] = '\0';

    // Append ".csv" if not already present.
    if (strstr(fileName, ".csv") == NULL) {
        strncat(fileName, ".csv", sizeof(fileName) - strlen(fileName) - 1);
    }

    USER_LOG_INFO("Received CSV file name: %s", fileName);
    DjiTest_WidgetLogAppend("Received CSV file name: %s", fileName);

    // Indicate that we are no longer waiting for a filename.
    waiting_for_csv_name = false;

    // Close the CSV file if it is open.
    if (g_csvFile) {
        fclose(g_csvFile);
        g_csvFile = NULL;
    }

    // Construct the absolute destination path.

    // Get current UTC time.
    time_t now = time(NULL);
    struct tm utc_tm;
    gmtime_r(&now, &utc_tm);
    char utcTimeStr[32];
    strftime(utcTimeStr, sizeof(utcTimeStr), "_%Y_%m_%d_%H_%M_%S", &utc_tm);

    char newFilePath[256];
    snprintf(newFilePath, sizeof(newFilePath), "/home/rmbl/%s%s", utcTimeStr, fileName);

    // Check if the file already exists.
    struct stat st;
    int counter = 1;
    char candidate[256];
    // Start candidate with the initial newFilePath.
    strncpy(candidate, newFilePath, sizeof(candidate));
    candidate[sizeof(candidate)-1] = '\0';

    // If the candidate exists, modify the basename by appending a number.
    while (stat(candidate, &st) == 0) {
        // Parse fileName into basename and extension.
        char basename[256] = {0};
        char extension[32] = {0};
        char *dot = strrchr(fileName, '.');
        if (dot) {
            size_t baseLen = dot - fileName;
            if (baseLen > sizeof(basename) - 1) {
                baseLen = sizeof(basename) - 1;
            }
            strncpy(basename, fileName, baseLen);
            basename[baseLen] = '\0';
            strncpy(extension, dot, sizeof(extension));
            extension[sizeof(extension)-1] = '\0';
        } else {
            strncpy(basename, fileName, sizeof(basename)-1);
            basename[sizeof(basename)-1] = '\0';
            extension[0] = '\0';
        }
        // Create a new candidate with an appended number.
        snprintf(candidate, sizeof(candidate), "/home/rmbl/%s%d%s", basename, counter, extension);
        counter++;
    }

    // Attempt to rename the temporary CSV file to the candidate name.
    int ret = rename("/home/rmbl/psdk_log.csv", candidate);
    if (ret == 0) {
        USER_LOG_INFO("CSV file renamed to %s", candidate);
        DjiTest_WidgetLogAppend("CSV file renamed to %s", candidate);
    } else {
        USER_LOG_ERROR("Failed to rename CSV file: %s", strerror(errno));
        DjiTest_WidgetLogAppend("Failed to rename CSV file: %s", strerror(errno));
    }

    // Optionally, you could reopen a new CSV file for further logging:
    g_csvFile = fopen("/home/rmbl/psdk_log.csv", "w");
    if (g_csvFile == NULL) {
        USER_LOG_ERROR("Failed to open CSV log file.");
    }

    return 0;
}

T_DjiReturnCode OnWidgetSetValue(E_DjiWidgetType type, uint32_t index, int32_t value, void *userData)
{
    switch (index) {
        case 1:  // Button 1: Start logging
            if (value == 1) {
                waiting_for_csv_name = true;
                startLogging();
                DjiTest_WidgetLogAppend("Logging Data");
            }
            break;
        case 2:  // Button 2: Stop logging
            if (value == 1) {
                logging_active = false;
                DjiTest_WidgetLogAppend("Logging Stopped, to save CSV enter file name and hit send in settings");
            }
            break;
        case 3:  // Button 3: Shutdown and exit
            if (value == 1) {
                if (logging_active) {
                    DjiTest_WidgetLogAppend("Cannot Shutdown and Exit while Data is logging");
                } else if (waiting_for_csv_name == true) {
                    DjiTest_WidgetLogAppend("Any unsaved data will be lost! Press again to shutdown");
                    waiting_for_csv_name = false;
                } else {
                    exit_script_and_shutdown = true;
                    DjiTest_WidgetLogAppend("Shutting Down!");
                }
            }
            break;
        default:
            USER_LOG_INFO("Unknown widget index.");
            break;
    }
    return DJI_ERROR_SYSTEM_MODULE_CODE_SUCCESS;
}

T_DjiReturnCode OnWidgetGetValue(E_DjiWidgetType type, uint32_t index, int32_t *value, void *userData)
{
    *value = 0;
    return DJI_ERROR_SYSTEM_MODULE_CODE_SUCCESS;
}


